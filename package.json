{
  "name": "agent-api",
  "version": "0.1.0",
  "description": "A VoltAgent application",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env ./src",
    "build": "tsdown",
    "start": "node dist/index.js",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src",
    "typecheck": "tsc --noEmit",
    "volt": "volt"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.29",
    "@openrouter/ai-sdk-provider": "^2.1.1",
    "@voltagent/cli": "^0.1.10",
    "@voltagent/core": "^2.0.0",
    "@voltagent/libsql": "^2.0.0",
    "@voltagent/logger": "^2.0.0",
    "@voltagent/postgres": "^2.1.0",
    "ai": "^6.0.0",
    "dotenv": "^16.4.7",
    "openai": "^6.22.0",
    "pg": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.16.0",
    "@voltagent/server-hono": "^2.0.6",
    "tsdown": "^0.15.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
